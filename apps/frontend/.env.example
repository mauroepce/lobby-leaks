# API base URL — points at apps/api (local dev) or the deployed origin.
# Public because Next.js inlines `NEXT_PUBLIC_*` vars in the browser bundle;
# the API itself is public-read so there's no secret to protect here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Default tenant for v1 — single-tenant UI for now.
NEXT_PUBLIC_DEFAULT_TENANT=CL
